{
  "name": "dark-cloud-companion",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "plans": "vite-node --config vitest.config.ts scripts/planner/predefined.ts",
    "preview": "astro preview",
    "astro": "astro",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "fix": "pnpm run fmt && pnpm run lint:fix",
    "test": "vitest run",
    "typecheck": "astro sync && tsc --noEmit -p .",
    "e2e": "playwright test",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "node scripts/db/check.ts",
    "db:export": "node scripts/db/export.ts",
    "test:all": "pnpm run check && pnpm test && pnpm e2e"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@nanostores/react": "^2.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "highs": "^1.16.0",
    "lucide-react": "^1.77.0",
    "nanostores": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
