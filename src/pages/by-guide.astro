---
// The dashboard's by-guide tab (the dashboard reads its view from the path).
import Layout from "@/layouts/Layout.astro";
import { Dashboard } from "@/components/dashboard/Dashboard";
import { useTranslations } from "@/i18n";

const t = useTranslations();
---

<Layout title={`${t("dash.views.byGuide")} · ${t("app.name")}`}>
  <Dashboard client:load path="/by-guide" />
</Layout>
