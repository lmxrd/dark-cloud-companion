---
import Layout from "@/layouts/Layout.astro";
import { PageHeader } from "@/components/PageHeader";
import { FishingPage } from "@/components/reference/FishingPage";
import { useTranslations } from "@/i18n";

const t = useTranslations();
---

<Layout title={`${t("fishing.title")} · ${t("app.name")}`}>
  <PageHeader title={t("fishing.title")} description={t("fishing.intro")} />
  <FishingPage client:load />
</Layout>
