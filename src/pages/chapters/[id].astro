---
// The dashboard's chapter view on one chapter (the dashboard reads the chapter from the path).
import Layout from "@/layouts/Layout.astro";
import { Dashboard } from "@/components/dashboard/Dashboard";
import { useTranslations } from "@/i18n";
import { chapters } from "@/lib/data";

export function getStaticPaths() {
  return chapters.map((c) => ({ params: { id: c.id }, props: { title: c.title } }));
}
const { id } = Astro.params;
const { title } = Astro.props;
const t = useTranslations();
---

<Layout title={`${title} · ${t("app.name")}`}>
  <Dashboard client:load path={`/chapters/${id}`} />
</Layout>
