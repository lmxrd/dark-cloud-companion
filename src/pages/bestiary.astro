---
import Layout from "@/layouts/Layout.astro";
import { PageHeader } from "@/components/PageHeader";
import { BestiaryPage } from "@/components/reference/BestiaryPage";
import { useTranslations } from "@/i18n";

const t = useTranslations();
---

<Layout title={`${t("bestiary.title")} · ${t("app.name")}`}>
  <PageHeader title={t("bestiary.title")} description={t("bestiary.intro")} />
  <BestiaryPage client:load />
</Layout>
