---
import Layout from "@/layouts/Layout.astro";
import { useTranslations } from "@/i18n";
import { floors } from "@/lib/db/data";
import { FloorPage } from "@/components/db/pages/PlacePages";

export function getStaticPaths() {
  return floors.map((s) => ({ params: { id: s.id }, props: { section: s } }));
}

const t = useTranslations();
const { section } = Astro.props;
---

<Layout title={`${section.title} · ${t("app.name")}`} page={section.title}>
  <FloorPage section={section} />
</Layout>
