---
import Layout from "@/layouts/Layout.astro";
import { PageHeader } from "@/components/PageHeader";
import { ShopsPage } from "@/components/reference/ShopsPage";
import { useTranslations } from "@/i18n";

const t = useTranslations();
---

<Layout title={`${t("shops.title")} · ${t("app.name")}`}>
  <PageHeader title={t("shops.title")} description={t("shops.intro")} />
  <ShopsPage client:load />
</Layout>
