---
import Layout from "@/layouts/Layout.astro";
import { PageHeader } from "@/components/PageHeader";
import { MonsterTracker } from "@/components/minigames/MonsterTracker";
import { useTranslations } from "@/i18n";

const t = useTranslations();
---

<Layout title={`${t("monsters.title")} · ${t("app.name")}`}>
  <PageHeader title={t("monsters.title")} />
  <MonsterTracker client:load />
</Layout>
